# Copiez ce fichier en .env et adaptez les valeurs.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=data/compta.db
# Clé maîtresse de 32 octets en base64 (OBLIGATOIRE en production) :
#   openssl rand -base64 32
# Conservez-la dans un coffre-fort (HSM, Vault, KMS) : sa perte rend les données chiffrées irrécupérables.
APP_MASTER_KEY=
# Origine publique de l'application (contrôle CSRF)
PUBLIC_ORIGIN=http://localhost:5173
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
LOG_LEVEL=info
# Assistance IA (lecture des pièces) — optionnelle. Sans clé, l'IA est inactive.
# ANTHROPIC_API_KEY=
# IA_MODELE=claude-opus-5-5
# IA_ACTIVE=true
